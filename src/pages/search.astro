---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
const c = [{ name: 'Home', url: '/' }, { name: 'Search' }];
---
<Base title="Search" description="Search government jobs, admit cards, results and answer keys on ResultDosti." noindex>
  <div class="wrap">
    <Crumbs items={c} />
    <div class="list-head"><h1>Search ResultDosti</h1></div>
    <section class="card"><div id="search"></div></section>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        var ui = new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false, translations: { placeholder: 'Search exam, result, admit card' } });
        var q = new URLSearchParams(location.search).get('q');
        if (q) ui.triggerSearch(q);
      });
    </script>
  </div>
</Base>
