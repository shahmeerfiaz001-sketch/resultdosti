---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you are looking for is not available on ResultDosti." noindex>
  <div class="wrap err">
    <p class="big">404</p>
    <h1>This page is not available</h1>
    <p>It may have expired or moved. Try the latest updates or search.</p>
    <div class="cta-row" style="justify-content:center">
      <a class="btn btn-main" href="/">Go to home</a>
      <a class="btn btn-line" href="/search/">Search</a>
    </div>
  </div>
</Base>
