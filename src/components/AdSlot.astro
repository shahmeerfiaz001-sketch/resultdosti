---
import ads from '../data/ads.json';
interface Props { name: string; }
const { name } = Astro.props;
const slot = (ads.slots as Record<string, { enabled: boolean; adsenseSlot: string; html: string }>)[name];
const show = ads.enabled && slot && slot.enabled && (slot.html || (ads.adsenseClient && slot.adsenseSlot));
---
{show && (
  <aside class="ad" aria-label="Advertisement">
    <span class="ad-label">Advertisement</span>
    {slot.html ? <Fragment set:html={slot.html} /> : <Fragment set:html={`<ins class="adsbygoogle" style="display:block" data-ad-client="${ads.adsenseClient}" data-ad-slot="${slot.adsenseSlot}" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle=window.adsbygoogle||[]).push({});</script>`} />}
  </aside>
)}
