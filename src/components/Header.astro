---
import site from '../../site.config.json';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const tabs = [
  { label: 'Home', url: '/' },
  { label: 'Latest Jobs', url: `/${site.paths.job}/` },
  { label: 'Admit Card', url: `/${site.paths.admit}/` },
  { label: 'Result', url: `/${site.paths.result}/` },
  { label: 'Answer Key', url: `/${site.paths.answer}/` },
  { label: 'Syllabus', url: `/${site.paths.syllabus}/` },
  { label: 'Exams', url: '/exam/' },
  { label: 'Meri Naukri', url: '/meri-naukri/' },
  { label: 'UP', url: '/state/up/' },
  { label: 'Bihar', url: '/state/bihar/' },
  { label: 'Central', url: '/state/central/' }
];
const active = (u: string) => (u === '/' ? path === '/' : path.startsWith(u));
---
<header class="top">
  <div class="wrap">
    <div class="top-row">
      <a class="brand" href="/" aria-label={`${site.name} home`}><Logo /><span>Result<b>Dosti</b></span></a>
      <form class="top-search" action="/search/" role="search">
        <label for="q" class="skip">Search</label>
        <input id="q" name="q" type="search" placeholder="Search exam, result, admit card" autocomplete="off" />
        <button type="submit" aria-label="Search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg></button>
      </form>
      <a class="search-icon" href="/search/" aria-label="Search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg></a>
      {site.telegram && (
        <a class="tg-btn" href={site.telegram} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3l-3.3 15.6c-.2 1.1-.9 1.4-1.8.9l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.3-8.4c.4-.4-.1-.6-.6-.2L6.1 13.4l-5-1.6c-1.1-.3-1.1-1.1.2-1.6L20.6 2.9c.9-.3 1.7.2 1.3 1.4z"/></svg>
          <span>Join Telegram</span>
        </a>
      )}
    </div>
    <nav class="tabs" aria-label="Sections">
      {tabs.map((t) => <a href={t.url} aria-current={active(t.url) ? 'page' : undefined}>{t.label}</a>)}
    </nav>
  </div>
</header>
